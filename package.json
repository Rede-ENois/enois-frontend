{
  "name": "connect-grow",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "prettier": "prettier --write \".\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:eslint-rules": "node eslint/rules/jsx-content-spacing.test.js && node eslint/rules/type-boundaries.test.js",
    "format": "prettier --write .",
    "prepare": "simple-git-hooks",
    "generate:api": "tsx scripts/fetch-openapi-spec.ts --fetch && tsx scripts/generate-api.ts",
    "check:api-matrix": "tsx scripts/check-api-matrix.ts",
    "generate:api:watch": "orval --config orval.config.ts --watch"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@rede-enois/design-system": "^0.17.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "1.170.13",
    "@tanstack/react-start": "1.168.22",
    "@tanstack/router-plugin": "1.168.16",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.3.2",
    "@orval/core": "^8.44.0",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.260603-beta",
    "orval": "^8.22.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
