# Exemplo para desenvolvimento local. Em producao/homologacao os valores vem da plataforma de deploy.
# Destino do proxy de desenvolvimento e dos loaders SSR (SEM /api no final).
# E o backend local; o Vite encaminha /api/... mantendo o prefixo.
BACKEND_TARGET=http://localhost:8081

# Variaveis do front (VITE_* sao embutidas no bundle e ficam publicas).
# No dev use /api relativo: o cookie de sessao fica em localhost e passa pelo proxy do Vite.
VITE_API_BACKEND=/api
# Origem publica declarada pelo SSR no header X-Client-Origin (a mesma liberada no CORS do dev).
VITE_SITE_URL=http://localhost:5173
# Opcional: so resolve URLs antigas de midia do ImageKit (o envio por ele esta desativado).
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/socialcoisa

# Cloudflare Turnstile (anti-bot). Sem essa variavel, o widget nao aparece.
# Dev/teste: use a test key 1x00000000000000000000AA (sempre passa).
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
